DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60
CSRF_TRUSTED_ORIGINS=
DJANGO_MEDIA_ROOT=
DJANGO_STATIC_ROOT=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=eRepository <noreply@school.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
API_ANON_RATE=60/hour
API_USER_RATE=1000/hour
API_LOGIN_RATE=10/minute
API_REGISTRATION_RATE=5/hour
