<service>
  <id>erepository-backend</id>
  <name>JSHS eRepository Backend</name>
  <description>Django API served by Waitress for the JSHS eRepository.</description>
  <executable>D:\eRepository\backend\.venv\Scripts\python.exe</executable>
  <arguments>-m waitress --listen=127.0.0.1:8000 --threads=8 --max-request-body-size=57671680 config.wsgi:application</arguments>
  <workingdirectory>D:\eRepository\backend</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>D:\eRepository\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
