<service>
  <id>caddy</id>
  <name>Caddy Web Server</name>
  <description>HTTPS reverse proxy and static web server for the JSHS eRepository.</description>
  <executable>D:\eRepository\tools\caddy\caddy.exe</executable>
  <arguments>run --config D:\eRepository\tools\caddy\Caddyfile --adapter caddyfile</arguments>
  <workingdirectory>D:\eRepository\tools\caddy</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>D:\eRepository\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
